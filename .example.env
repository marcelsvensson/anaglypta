# spotify-api (create an app at https://developer.spotify.com/dashboard), only needed for spotify projects.
# The playlists themselves are in projects.json (`npm run setup` adds them)
CLIENT_ID=
# optional - only for apps created before the 2026 api changes, newer apps log in with `npm run auth`
CLIENT_SECRET=
# optional - country code (e.g. SE) for track availability
SPOTIFY_MARKET=
# optional - port for the `npm run auth` login, default 8888 (redirect uri: http://127.0.0.1:8888/callback)
SPOTIFY_AUTH_PORT=

# tmdb (themoviedb.org), only needed for tmdb projects: the "API Read Access Token" (the long one, not the API key)
# from https://www.themoviedb.org/settings/api - free for non-commercial use. The lists themselves are in projects.json
TMDB_TOKEN=

# optional, experimental - use the collage as your Google Meet background (`npm run daily-new` skips this when it's empty, `npm run random-meet` needs it).
# One Meet background for all projects: daily-new/random-meet put in the collage (or with --video the video) of the project you run them for.
# `npm run setup:meet` fills it in: the file Chrome created when you uploaded the Anaglypta card in Meet, on a mac somewhere under:
# ~/Library/Application Support/Google/Chrome/Default/IndexedDB/https_meet.google.com_0.indexeddb.blob
GOOGLE_MEET_BLOB_PATH=


