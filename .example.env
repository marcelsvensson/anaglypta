# spotify-api (create an app at https://developer.spotify.com/dashboard)
CLIENT_ID=
# optional - only for apps created before the 2026 api changes, newer apps log in with `npm run auth`
CLIENT_SECRET=
# the id from the playlist url: https://open.spotify.com/playlist/<PLAYLIST_ID>
PLAYLIST_ID=
# optional - country code (e.g. SE) for track availability
SPOTIFY_MARKET=
# optional - port for the `npm run auth` login, default 8888 (redirect uri: http://127.0.0.1:8888/callback)
SPOTIFY_AUTH_PORT=

# optional - sftp upload of the site, leave all empty to skip the upload
SFTP_HOST=
# default 22
SFTP_PORT=
SFTP_USER=
# use either a password or a private key (e.g. ~/.ssh/id_ed25519)
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSPHRASE=
# folder to upload to, relative to the folder you land in after login (e.g. public_html/albums)
SFTP_SPECIFIC_PATH=
