{
  "settings": {
    "default": "spotify/album",
    "defaults": {
      "maxItems": 200,
      "imageSize": 640,
      "allowMix": true,
      "collage": { "layout": "13x9/5", "gap": 8, "skip": [[12, 8]] }
    },
    "sources": { "spotify": {}, "local": { "maxItems": 100 }, "tmdb": { "allowMix": false }, "steam": { "aspect": "2:3" } }
  },
  "projects": {
    "default": "local/cats",
    "spotify": {
      "album": { "playlist": "https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M?si=x", "maxItems": 50 },
      "cats": { "playlist": "37i9dQZF1DXcBWIGoYBM5M", "collage": { "skip": [] }, "allowMix": false }
    },
    "local": {
      "cats": { "path": "/pics/cats", "collage": { "layout": "11x5/3" } },
      "dogs": { "path": "/pics/dogs", "maxItems": 30 },
      "Bad_Name": { "path": "/pics/bad" }
    },
    "tmdb": {
      "series": { "list": "https://www.themoviedb.org/list/8512345-my-series?view=grid", "allowMix": true },
      "films": { "list": "42" },
      "broken": { "list": "https://www.themoviedb.org/u/someone/lists" }
    },
    "steam": {
      "games": { "profile": "https://steamcommunity.com/id/your-name/" },
      "friend": { "profile": "https://steamcommunity.com/profiles/76500000000000042" },
      "store": { "profile": "https://store.steampowered.com/app/620/" }
    }
  },
  "cases": [
    {
      "flags": {},
      "expected": {
        "source": "local", "name": "cats", "id": "local/cats", "folder": "projects/local/cats", "path": "/pics/cats",
        "maxItems": 100, "imageSize": 640,
        "collage": { "layout": "11x5/3", "gap": 8, "skip": [[12, 8]] }
      }
    },
    {
      "flags": { "project": "album" },
      "expected": { "source": "spotify", "name": "album", "maxItems": 50, "playlistId": "37i9dQZF1DXcBWIGoYBM5M" }
    },
    {
      "flags": { "project": "spotify/cats" },
      "expected": {
        "source": "spotify", "name": "cats", "playlistId": "37i9dQZF1DXcBWIGoYBM5M",
        "collage": { "layout": "13x9/5", "gap": 8, "skip": [] }
      }
    },
    { "flags": { "source": "local", "project": "cats" }, "expected": { "source": "local", "name": "cats" } },
    { "flags": { "source": "spotify" }, "expected": { "source": "spotify", "name": "album" } },
    { "flags": { "source": "local" }, "expected": { "source": "local", "name": "cats" } },
    { "flags": { "project": "dogs" }, "expected": { "source": "local", "name": "dogs", "maxItems": 30 } },
    { "flags": { "project": "cats" }, "error": "pick one with --source" },
    { "flags": { "project": "nope" }, "error": "Unknown project" },
    { "flags": { "source": "instagram" }, "error": "Unknown source" },
    { "flags": { "source": "local", "project": "spotify/album" }, "error": "doesn't match" },
    { "flags": { "project": "Bad_Name" }, "error": "lowercase letters" },
    { "flags": { "project": "series" }, "expected": { "source": "tmdb", "name": "series", "listId": "8512345", "folder": "projects/tmdb/series" } },
    { "flags": { "project": "tmdb/films" }, "expected": { "listId": "42" } },
    { "flags": { "project": "broken" }, "expected": { "source": "tmdb", "listId": null } },
    { "flags": { "project": "games" }, "expected": { "source": "steam", "name": "games", "aspect": "2:3", "steam": { "vanity": "your-name" }, "folder": "projects/steam/games" } },
    { "flags": { "project": "steam/friend" }, "expected": { "steam": { "steamId": "76500000000000042" } } },
    { "flags": { "project": "store" }, "expected": { "source": "steam", "steam": null } },
    { "flags": { "project": "mix" }, "error": "only works with" },
    { "flags": { "source": "local", "project": "mix" }, "error": "only works with" }
  ],
  "mixCases": [
    { "source": null, "expected": ["local/cats", "local/dogs", "spotify/album", "steam/friend", "steam/games", "steam/store", "tmdb/series"] },
    { "source": "spotify", "expected": ["spotify/album"] },
    { "source": "tmdb", "expected": ["tmdb/series"] }
  ]
}
