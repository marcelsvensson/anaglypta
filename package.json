{
  "name": "anaglypta",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "setup:python": "node ./scripts/setup.js --python",
    "setup:meet": "node ./scripts/setup.js --meet",
    "auth": "node ./scripts/auth.js",
    "full": "node ./scripts/generate.js",
    "collage": "node ./scripts/python.js ./scripts/collage.py --randomize",
    "daily-new": "node ./scripts/generate.js --limit 1 && node ./scripts/python.js ./scripts/collage.py --latest && npm run meet",
    "meet": "node ./scripts/meet.js",
    "random-meet": "node ./scripts/meet.js --collage",
    "clean": "node ./scripts/clean.js",
    "reset": "node ./scripts/clean.js --reset",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test",
    "test:python": "node ./scripts/python.js -m unittest discover -s test -v"
  },
  "keywords": [
    "spotify",
    "background"
  ],
  "author": "marcelsvensson",
  "license": "ISC",
  "description": "generate a background grid from your spotify-playlist",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.6"
  }
}
