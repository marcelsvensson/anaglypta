{
  "name": "anaglypta",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "setup:python": "node ./scripts/setup.js --python",
    "auth": "node ./scripts/auth.js",
    "fetch": "node ./scripts/generate.js",
    "bitmap": "node ./scripts/python.js ./scripts/bitmapper.py",
    "collage": "node ./scripts/python.js ./scripts/bitmapper_collage.py --randomize",
    "full": "npm run fetch && npm run bitmap && node ./scripts/python.js ./scripts/bitmapper_collage.py",
    "daily": "npm run fetch && npm run bitmap && npm run build && npm run upload",
    "build": "eleventy",
    "dev": "eleventy --serve",
    "upload": "node ./scripts/upload.js",
    "clean": "node ./scripts/clean.js",
    "reset": "node ./scripts/clean.js --reset",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "spotify",
    "background"
  ],
  "author": "marcelsvensson",
  "license": "ISC",
  "description": "generate a background grid from your spotify-playlist",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "dotenv": "^18.0.6",
    "ssh2-sftp-client": "^12.1.1"
  },
  "allowScripts": {
    "ssh2": false,
    "cpu-features": false,
    "fsevents": false
  }
}
