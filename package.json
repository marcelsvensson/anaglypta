{
  "name": "anaglypta",
  "version": "1.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "setup:python": "node ./scripts/setup.js --python",
    "setup:meet": "node ./scripts/setup.js --meet",
    "auth": "node ./lib/sources/spotify/auth.js",
    "full": "node ./scripts/fetch.js",
    "collage": "node ./scripts/collage.js --randomize",
    "video": "node ./scripts/video.js",
    "daily-new": "node ./scripts/daily-new.js",
    "meet": "node ./scripts/meet.js",
    "random-meet": "node ./scripts/meet.js --collage",
    "clean": "node ./scripts/clean.js",
    "reset": "node ./scripts/clean.js --reset",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test",
    "test:python": "node ./scripts/python.js -m unittest discover -s test -v"
  },
  "keywords": [
    "spotify",
    "tmdb",
    "steam",
    "collage",
    "background",
    "google meet"
  ],
  "author": "marcelsvensson",
  "license": "ISC",
  "description": "generate a living background collage from the source of choice (spotify-playlist, tmdb-list, steam-library or a folder of images)",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "dependencies": {
    "dotenv": "^18.0.6"
  }
}
